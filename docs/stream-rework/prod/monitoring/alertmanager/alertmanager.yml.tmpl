# Alertmanager config TEMPLATE (#178) — delivers to the project Telegram bot.
# Alertmanager does NOT expand env vars, so render this to alertmanager.yml at
# deploy:  set -a; . monitoring.env; : "${TELEGRAM_TOPIC_ID:=26}"; set +a; envsubst < alertmanager.yml.tmpl > alertmanager.yml
# The rendered alertmanager.yml contains the bot token → it is gitignored.
# Token + chat id reuse the project bot (Bitwarden: TELEGRAM_BOT_TOKEN/TELEGRAM_ADMIN_CHAT_ID).
# message_thread_id pins alerts to the "MoafunkBot" forum topic (TELEGRAM_TOPIC_ID,
# default 26) — without it Alertmanager posts into the group's "General" topic.
# WATCHDOG_PING_URL (Bitwarden SM) is the healthchecks.io ping URL for the
# dead-man's switch. It must be set: an empty url makes this config invalid.
global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  routes:
    # Dead-man's switch: the always-firing Watchdog goes ONLY to the heartbeat
    # webhook, never to Telegram. Keep this route first. A repeat is sent on the
    # first group_interval tick after repeat_interval has passed, so 1m + 5m
    # gives a ping about every 6 min. healthchecks.io pages when they stop.
    - matchers: ['alertname = "Watchdog"']
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
    # Info-level (e.g. prolonged zero-listeners) → still Telegram but rarely repeats.
    - matchers: ['severity = "info"']
      receiver: telegram
      repeat_interval: 24h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "${TELEGRAM_BOT_TOKEN}"
        chat_id: ${TELEGRAM_ADMIN_CHAT_ID}
        message_thread_id: ${TELEGRAM_TOPIC_ID}
        parse_mode: HTML
        send_resolved: true
        message: |
          <b>{{ .Status | toUpper }}</b> {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})
          {{ range .Alerts }}{{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}

  - name: heartbeat
    webhook_configs:
      - url: "${WATCHDOG_PING_URL}"
        # When Prometheus dies, Watchdog times out as "resolved". That POST
        # would count as a healthy ping and delay the page, so never send it.
        send_resolved: false

inhibit_rules:
  # If the stream is down, don't also page about zero listeners.
  - source_matchers: ['alertname = "StreamProbeDown"']
    target_matchers: ['alertname = "StreamZeroListenersProlonged"']
    equal: ["instance"]
