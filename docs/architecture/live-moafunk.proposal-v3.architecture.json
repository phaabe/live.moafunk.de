        "note": "200 listeners at 256 kbps need 51.2 Mbit/s before overhead. Keep one server; measure during recording before adding capacity."
      },
      {
        "id": "safe-show",
        "label": "Keep shows running",
        "focus": [
          "admin",
          "deploy",
          "api",
          "liquidsoap",
          "pages",
          "probe"
        ],
        "note": "Proposed: pre-show checks, maintenance gate and external audio sampling. Fallback needs player support for interruptions."
      },
      {
        "id": "recovery",
        "label": "Recover recordings",
        "focus": [
          "api",
          "spool",
          "r2",
          "sqlite",
          "backups"
        ],
        "note": "Proposed: cover both buckets, retain deleted versions and test a restore. Limit heavy media work; keep capture independent."
      }
    ]
