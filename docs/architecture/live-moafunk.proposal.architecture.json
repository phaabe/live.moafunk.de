    "views": [
      {
        "id": "recording-lifecycle",
        "label": "Recording lifecycle",
        "focus": [
          "api",
          "spool",
          "worker",
          "r2",
          "sqlite"
        ],
        "note": "Segments stay on disk until the R2 object is verified and the row is committed. A worker recovers and retries after any crash."
      },
      {
        "id": "durable-jobs",
        "label": "Durable jobs",
        "focus": [
          "api",
          "sqlite",
          "worker",
          "providers"
        ],
        "note": "Handlers commit the job with the domain change. The worker leases it, retries with backoff, and reconciles provider results."
      },
      {
        "id": "ops-outside-host",
        "label": "Ops outside the host",
        "focus": [
          "monitor",
          "nginx",
          "sqlite",
          "r2",
          "backups"
        ],
        "note": "An external probe checks TLS and live audio. Daily SQLite snapshots and both R2 buckets go off-site and get restore-tested."
      }
    ]
  },
