  "cards": [
    {
      "dot": "cyan",
      "title": "One box, two networks",
      "items": [
        "unheard-api on the docker bridge net; Liquidsoap + Icecast-KH host-networked",
        "The producer reaches the harbor via host.docker.internal",
        "nginx TLS-fronts the API, the admin SPA and /live.mp3"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recording is the system of record",
      "items": [
        "WS chunks → ffmpeg tee → segments → concat → R2 multipart",
        "Finalize also uploads a private SoundCloud track",
        "Orphaned segments recovered at startup; failures on /metrics"
      ]
    },
    {
      "dot": "amber",
      "title": "Delivery and ops",
      "items": [
        "main → GHCR image → deploy-hetzner over SSH",
        "Public site → GitHub Pages; clients self-update via /version.json",
        "Weekly SQLite + R2 backup; Prometheus + Grafana on the box"
      ]
    }
  ]
