{
  "uid": "epic-agents",
  "title": "Claude & Codex \u2014 Epic progress",
  "tags": [
    "agents",
    "epic"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Agent",
        "type": "custom",
        "query": "claude,codex",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Claude + Codex \u2022 live work and delivery",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Local activity refreshes every **5 seconds**; GitHub polls every **120 seconds**. **Active tick \u2260 model working. Successful session \u2260 task completed.**\n\n[Project board](https://github.com/users/anneoneone/projects/2) \u00b7 [Architecture epic](https://github.com/phaabe/live.moafunk.de/issues/312) \u00b7 [Open PRs](https://github.com/phaabe/live.moafunk.de/pulls)\n\nMissing/stale data hides live and queue panels. Check freshness and alerts first."
      }
    },
    {
      "id": 2,
      "title": "Local data age",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - epic_local_snapshot_timestamp_seconds",
          "instant": true,
          "range": false,
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": ""
    },
    {
      "id": 3,
      "title": "GitHub data age",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - epic_github_snapshot_timestamp_seconds",
          "instant": true,
          "range": false,
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": ""
    },
    {
      "id": 4,
      "title": "Last GitHub poll",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_github_collection_success",
          "instant": true,
          "range": false,
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": ""
    },
    {
      "id": 5,
      "title": "Pause requested",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_pause_requested and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "green"
                },
                "1": {
                  "text": "Yes",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": ""
    },
    {
      "id": 6,
      "title": "Runner state",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_runner_state{agent=~\"$agent\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "{{agent}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GitHub"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Running means the recorded PID is alive. Inactive does not mean a scheduler is installed. Orphaned means its lock remains but its PID is gone. Overdue means its original timeout budget has elapsed.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            },
            "indexByName": {
              "agent": 0,
              "state": 1
            },
            "renameByName": {
              "agent": "Agent",
              "state": "State",
              "action": "Action",
              "target": "GitHub",
              "reason": "Reason",
              "title": "Title",
              "review": "Review",
              "checks": "CI",
              "draft": "Draft"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Current tick elapsed",
      "type": "stat",
      "gridPos": {
