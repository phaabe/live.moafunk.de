    "agents",
    "epic"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/epic-agents",
      "targetBlank": false
    },
    {
      "title": "Codex details",
      "url": "/d/epic-agent-codex",
      "targetBlank": false
    },
    {
      "title": "Epic",
      "url": "https://github.com/phaabe/live.moafunk.de/issues/312",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search log",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "**Claude** runner · [‹ Overview](/d/epic-agents) · [Codex](/d/epic-agent-codex) · Log file: `~/.local/state/epic-loop/claude.log`"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "stat",
      "title": "State",
      "description": "running: a tick holds the lock. It may be selecting work, not generating output. inactive: no tick runs now.",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_runner_state{agent=\"claude\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "–",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inactive"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "orphaned"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "overdue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
