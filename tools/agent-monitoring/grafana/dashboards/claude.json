    {
      "type": "table",
      "title": "Working on now",
      "description": "The running tick's action, placed in the epic. Empty when idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(label_replace((epic_current_action_info{agent=\"claude\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)), \"level\", \"Action\", \"\", \"\"), \"depth\", \"0\", \"\", \"\"), \"text\", \"$1\", \"action\", \"(.*)\") or (epic_task_level_info and on() (time() - epic_github_snapshot_timestamp_seconds < 300)) * on(target) group_left() (epic_current_action_info{agent=\"claude\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No task",
          "custom": {
            "filterable": false,
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Path"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "${__data.fields.url}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "level",
                "text",
                "url",
                "depth"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "depth",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "depth": true
            },
            "indexByName": {
              "level": 0,
              "text": 1
            },
            "renameByName": {
              "level": "Level",
              "text": "Path"
            }
          }
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
