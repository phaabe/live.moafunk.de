    {
      "type": "table",
      "title": "Open PRs",
      "description": "Review is the other agent's latest verdict for the current head. This page never authorizes a merge.",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(epic_pr_info{agent=\"claude\"} and on() (time() - epic_github_snapshot_timestamp_seconds < 300)) * on(target) group_left(task, task_url, subtask, subtask_url, leaf) (epic_task_context_info and on() (time() - epic_github_snapshot_timestamp_seconds < 300)) or on(target) (epic_pr_info{agent=\"claude\"} and on() (time() - epic_github_snapshot_timestamp_seconds < 300))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "–",
          "custom": {
            "filterable": false,
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PR"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "${__data.fields.target}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Subtask"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "${__data.fields.subtask_url}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "subtask_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Review"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "approved": {
                        "color": "green",
                        "index": 0
                      },
                      "changes requested": {
                        "color": "red",
