        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_tick_info{agent=\"$agent\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
