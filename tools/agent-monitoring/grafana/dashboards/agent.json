    {
      "type": "table",
      "title": "Outcome per hour · 7 days",
      "description": "Worst outcome of each local hour. Empty: no tick.",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_tick_hour_worst{agent=\"$agent\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "columnField": "hour",
            "rowField": "day",
            "valueField": "Value"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^day\\\\hour$",
            "renamePattern": "day"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No ticks in 7 days",
          "custom": {
            "filterable": false,
            "align": "auto",
            "inspect": false
