    {
      "type": "barchart",
      "title": "Permission gate · per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (increase(epic_permission_decisions_total{agent=\"$agent\"}[1h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported by this runner (Claude only)",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
