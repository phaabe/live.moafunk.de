    {
      "type": "table",
      "title": "Backoff",
      "description": "Codex retry delays still active. A retry within 10 min is about to happen.",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_backoff_info{agent=\"$agent\"} * 1000 and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "target",
                "Value",
                "current_head",
                "estimated"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "target": 0,
              "Value": 1,
              "current_head": 2,
              "estimated": 3
            },
            "renameByName": {
              "target": "Target",
              "Value": "Retry after",
              "current_head": "Head still current",
              "estimated": "Estimated"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported by this runner (Codex only) or no delay",
          "custom": {
            "filterable": false,
            "align": "auto",
            "inspect": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*/pull/(\\d+)$",
                      "result": {
                        "index": 0,
                        "text": "PR $1"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*/issues/(\\d+)$",
                      "result": {
                        "index": 1,
                        "text": "issue $1"
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Retry after"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "text"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "filterable",
                "value": false
              }
            ]
          }
        ]
