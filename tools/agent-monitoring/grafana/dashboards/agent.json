        "type": "prometheus",
        "uid": "agent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "epic_agent_info{agent=\"$agent\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "epic_agent_presence_info{agent=\"$agent\"} and on() (time() - epic_local_snapshot_timestamp_seconds < 30)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "epic_agent_interval_seconds{agent=\"$agent\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "epic_agent_budget_seconds{agent=\"$agent\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "agent",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "kind",
                "agent",
                "label",
                "presence",
                "Value #C",
                "Value #D"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "kind": 0,
              "agent": 1,
              "label": 2,
              "presence": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "kind": " ",
              "agent": "Agent",
              "label": "Label",
              "presence": "Presence",
              "Value #C": "Interval",
              "Value #D": "Tick budget"
