// Ship the two runner logs to Loki. The log directory is mounted read-only.
local.file_match "runners" {
  path_targets = [
    {"__path__" = "/logs/claude.log", "agent" = "claude"},
    {"__path__" = "/logs/codex.log", "agent" = "codex"},
  ]
}

loki.source.file "runners" {
  targets    = local.file_match.runners.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
