// Ship the runner logs to Loki. The log directory is mounted read-only.
// Alloy follows links when it opens a file, and the agents can write their
// folders, so Alloy never globs them. The collector lists the logs to ship
// (regular files of known agents, never links) and rebuilds the list every
// cycle; Alloy re-reads it every 10 s.
discovery.file "runners" {
  files            = ["/targets/targets.json"]
  refresh_interval = "10s"
}

loki.source.file "runners" {
  targets    = discovery.file.runners.targets
  forward_to = [loki.process.permissions.receiver]
}

// Permission gate lines ("<time> allow|deny ...") keep their own time and get
// a decision label. Loki rejects lines older than one week, so older lines
// are dropped here; the collector's counter still covers the whole file.
loki.process "permissions" {
  forward_to = [loki.write.local.receiver]

  stage.match {
    selector = "{stream=\"permissions\"}"

    stage.regex {
      expression = "^(?P<ts>\\S+) (?P<decision>allow|deny) "
    }

    stage.timestamp {
      source = "ts"
      format = "RFC3339"
    }

    stage.labels {
      values = {
        decision = "",
      }
    }

    stage.drop {
      older_than          = "167h"
      drop_counter_reason = "older_than_loki_limit"
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
