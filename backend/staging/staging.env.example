# Staging API settings. Copy to /opt/unheard-staging/.env and fill the
# <...> values from Bitwarden (STAGING_* items). Never copy production values.
# staging.sh refuses to start when a value below is unsafe.
#
# dotenvy stops reading at the first unquoted value with a space and skips
# every later line, so quote values like "Moafunk Staging".

APP_ENV=staging
ADMIN_BASE_URL=https://staging.live.moafunk.de

SECRET_KEY=<STAGING_SECRET_KEY>
SUPERADMIN_USERNAME=<STAGING_SUPERADMIN_USERNAME>
# Argon2 hash from `cargo run --bin hash_password -- '<password>'`. Single
# quotes: dotenvy expands `$` inside double quotes.
SUPERADMIN_PASSWORD_HASH='<STAGING_SUPERADMIN_PASSWORD_HASH>'

# Own buckets, and a token that can only reach them. Unset bucket names fall
# back to production buckets, so both lines are required.
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<STAGING_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<STAGING_R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=unheard-artists-staging
R2_SHOWS_BUCKET_NAME=moafunk-staging

# Own stream chain: staging harbor 8015, staging Icecast 8020.
STREAM_OUTPUT=icecast
ICECAST_URL=icecast://source:<STAGING_HARBOR_LIVE_PASSWORD>@host.docker.internal:8015/live
ICECAST_TEST_URL=icecast://source:<STAGING_HARBOR_TEST_PASSWORD>@host.docker.internal:8015/test
ICECAST_STATUS_URL=http://host.docker.internal:8020/status-json.xsl

# Never reach real accounts from staging.
SOUNDCLOUD_AUTO_UPLOAD=false
TELEGRAM_ENABLED=false

# Must stay absent in staging (staging.sh checks):
# GITHUB_DISPATCH_TOKEN (would start the production backup workflow),
# SOUNDCLOUD_*, TELEGRAM_BOT_TOKEN, TELEGRAM_*_CHAT_ID, INSTAGRAM_*,
# FACEBOOK_*, OPENAI_API_KEY, RECOVERY_*.
