# Staging API settings. Do not fill this by hand: push-secrets.sh sends the
# <STAGING_*> values from Bitwarden and `staging.sh install-env` writes
# /opt/unheard-staging/.env from this file. staging.sh refuses to start when a
# value below is unsafe.
#
# dotenvy stops reading at the first unquoted value with a space and skips
# every later line, so quote values like "Moafunk Staging".

APP_ENV=staging
ADMIN_BASE_URL=https://staging.live.moafunk.de

SECRET_KEY=<STAGING_SECRET_KEY>
SUPERADMIN_USERNAME=staging-admin
# Argon2 hash of STAGING_SUPERADMIN_PASSWORD, made on the box by install-env.
# Single quotes: dotenvy expands `$` inside double quotes.
SUPERADMIN_PASSWORD_HASH='<STAGING_SUPERADMIN_PASSWORD_HASH>'

# A host login for testing. Not read by the backend: `staging.sh up` and
# `seed-db` create or reset this user from these two lines.
STAGING_HOST_USERNAME=staging-host
STAGING_HOST_PASSWORD_HASH='<STAGING_HOST_PASSWORD_HASH>'

# Own buckets, and a token that can only reach them (staging.sh check-r2
# proves it). Unset bucket names fall back to production buckets, so both
# lines are required.
R2_ACCOUNT_ID=4acacbddb37198e8eed490e4b7c752ee
R2_ACCESS_KEY_ID=<STAGING_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<STAGING_R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=unheard-artists-staging
R2_SHOWS_BUCKET_NAME=moafunk-staging

# Own stream chain on this box: harbor 8005, Icecast 8010 (as in production).
STREAM_OUTPUT=icecast
ICECAST_URL=icecast://source:<STAGING_HARBOR_LIVE_PASSWORD>@host.docker.internal:8005/live
ICECAST_TEST_URL=icecast://source:<STAGING_HARBOR_TEST_PASSWORD>@host.docker.internal:8005/test
ICECAST_STATUS_URL=http://host.docker.internal:8010/status-json.xsl

# SoundCloud: the station's app (one app per account; its redirect URIs list
# the staging callback too) and an own test account, never the station account.
# The backend refuses a login of another account than SOUNDCLOUD_ACCOUNT and,
# after each upload, deletes all but the newest SOUNDCLOUD_KEEP_TRACKS tracks.
SOUNDCLOUD_CLIENT_ID=<STAGING_SOUNDCLOUD_CLIENT_ID>
SOUNDCLOUD_CLIENT_SECRET=<STAGING_SOUNDCLOUD_CLIENT_SECRET>
# Permalink of the test account (soundcloud.com/<permalink>), not a secret.
SOUNDCLOUD_ACCOUNT=moafunk-test
SOUNDCLOUD_REDIRECT_URI=https://staging.live.moafunk.de/api/soundcloud/callback
SOUNDCLOUD_AUTO_UPLOAD=true
SOUNDCLOUD_KEEP_TRACKS=10

# Never reach real accounts from staging.
TELEGRAM_ENABLED=false

# Must stay absent in staging (staging.sh checks):
# GITHUB_DISPATCH_TOKEN (would start the production backup workflow),
# SOUNDCLOUD_ACCESS_TOKEN and any other SOUNDCLOUD_* setting, any other
# TELEGRAM_* setting, INSTAGRAM_*, FACEBOOK_*, OPENAI_*, RECOVERY_*.
