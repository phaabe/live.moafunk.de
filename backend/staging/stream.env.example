# Staging stream chain (Liquidsoap + Icecast). Do not fill this by hand:
# `staging.sh install-env` writes /opt/unheard-staging/stream.env from this file
# with the values push-secrets.sh sends from Bitwarden. Never reuse
# production's harbor or Icecast passwords.

HARBOR_PORT=8005
ICECAST_PORT=8010

HARBOR_TEST_PASSWORD=<STAGING_HARBOR_TEST_PASSWORD>
HARBOR_LIVE_PASSWORD=<STAGING_HARBOR_LIVE_PASSWORD>
ICECAST_SOURCE_PASSWORD=<STAGING_ICECAST_SOURCE_PASSWORD>
ICECAST_ADMIN_PASSWORD=<STAGING_ICECAST_ADMIN_PASSWORD>
ICECAST_RELAY_PASSWORD=<STAGING_ICECAST_RELAY_PASSWORD>
