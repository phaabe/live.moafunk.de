# Staging stream chain (Liquidsoap + Icecast). Copy to
# /opt/unheard-staging/stream.env and fill from Bitwarden (STAGING_* items).
# Never reuse production's harbor or Icecast passwords.

HARBOR_PORT=8015
ICECAST_PORT=8020

HARBOR_TEST_PASSWORD=<STAGING_HARBOR_TEST_PASSWORD>
HARBOR_LIVE_PASSWORD=<STAGING_HARBOR_LIVE_PASSWORD>
ICECAST_SOURCE_PASSWORD=<STAGING_ICECAST_SOURCE_PASSWORD>
ICECAST_ADMIN_PASSWORD=<STAGING_ICECAST_ADMIN_PASSWORD>
ICECAST_RELAY_PASSWORD=<STAGING_ICECAST_RELAY_PASSWORD>
