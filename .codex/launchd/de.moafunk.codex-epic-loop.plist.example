<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.moafunk.codex-epic-loop</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__RUNNER_CHECKOUT__/.codex/codex-tick.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__RUNNER_CHECKOUT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__CODEX_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/epic-loop/codex-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/epic-loop/codex-launchd-error.log</string>
</dict>
</plist>
