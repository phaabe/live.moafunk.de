{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) || exit 2; /bin/bash \"$root/.codex/hooks/scripts/epic-guard.sh\" || exit 2",
            "timeout": 90,
            "statusMessage": "Checking architecture epic rules..."
          }
        ]
      }
    ]
  }
}
